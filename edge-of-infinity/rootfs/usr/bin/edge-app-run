#!/usr/bin/env bash
set -euo pipefail

source /usr/lib/bashio/bashio.sh

OPTIONS_PATH=/tmp/edge-runtime/native-options.json
python3 /usr/share/edge-of-infinity/edge_native_migration.py --options /data/options.json --output "${OPTIONS_PATH}" --home /homeassistant/edge --addon /config

read_option() {
  local key="$1"
  local fallback="$2"

  if [[ -f "${OPTIONS_PATH}" ]]; then
    jq -r --arg key "${key}" --arg fallback "${fallback}" 'if has($key) and .[$key] != null then .[$key] else $fallback end' "${OPTIONS_PATH}" 2>/dev/null || echo "${fallback}"
  else
    echo "${fallback}"
  fi
}

LOG_LEVEL="$(read_option 'log_level' 'info')"
API_PORT="$(read_option 'api_port' '8088')"
RECORDINGS_DIR="$(read_option 'recordings_dir' '/media/edge-of-infinity/recordings')"
DATABASE_PATH="$(read_option 'database_path' '/homeassistant/edge/edge.db')"
RETENTION_DAYS="$(read_option 'retention_days' '14')"
INSTALL_CUSTOM_COMPONENT="$(read_option 'install_custom_component' 'true')"
SYNC_ADDON_OPTIONS="$(read_option 'sync_addon_options' 'false')"
EDGE_RTC_RTSP_PORT="$(read_option 'edge_rtc_rtsp_port' '8556')"
EDGE_RTC_API_PORT="$(read_option 'edge_rtc_api_port' '9997')"

LOG_LEVEL="${LOG_LEVEL:-info}"
API_PORT="${API_PORT:-8088}"
RECORDINGS_DIR="${RECORDINGS_DIR:-/media/edge-of-infinity/recordings}"
DATABASE_PATH="${DATABASE_PATH:-/homeassistant/edge/edge.db}"
RETENTION_DAYS="${RETENTION_DAYS:-14}"
INSTALL_CUSTOM_COMPONENT="${INSTALL_CUSTOM_COMPONENT:-true}"
SYNC_ADDON_OPTIONS="${SYNC_ADDON_OPTIONS:-false}"
EDGE_RTC_RTSP_PORT="${EDGE_RTC_RTSP_PORT:-8556}"
EDGE_RTC_API_PORT="${EDGE_RTC_API_PORT:-9997}"

if [[ "${DATABASE_PATH}" == "/config/edge.db" ]]; then
  DATABASE_PATH="/homeassistant/edge/edge.db"
fi

mkdir -p "${RECORDINGS_DIR}"
mkdir -p "$(dirname "${DATABASE_PATH}")"
mkdir -p /config
mkdir -p /homeassistant/edge
mkdir -p /homeassistant/edge/snapshots
mkdir -p /tmp/edge-runtime
mkdir -p /media/edge-of-infinity/recordings

install_custom_component() {
  local source_dir="/usr/share/edge-of-infinity/custom_components/edge"
  local target_dir="/homeassistant/custom_components/edge"

  if [[ "${INSTALL_CUSTOM_COMPONENT}" != "true" ]]; then
    bashio::log.info "Custom component auto-install is disabled."
    return
  fi

  if [[ ! -d "${source_dir}" ]]; then
    bashio::log.warning "Custom component source is missing: ${source_dir}"
    return
  fi

  if [[ ! -d /homeassistant ]]; then
    bashio::log.warning "Home Assistant config mount is missing. Cannot install custom component."
    return
  fi

  mkdir -p /homeassistant/custom_components
  rm -rf "${target_dir}"
  cp -R "${source_dir}" "${target_dir}"
  bashio::log.info "Installed Home Assistant custom component at ${target_dir}"
}

option_has_value() {
  local key="$1"
  local value

  value="$(read_option "${key}" "")"
  [[ -n "${value}" && "${value}" != "null" ]]
}

has_addon_camera_options() {
  jq -e '.cameras | type == "array" and length > 0' "${OPTIONS_PATH}" >/dev/null 2>&1 ||
  option_has_value "hikvision_1_host" ||
    option_has_value "hikvision_1_rtsp_main" ||
    option_has_value "hikvision_2_host" ||
    option_has_value "hikvision_2_rtsp_main"
}

addon_camera_options_hash() {
  if [[ ! -f "${OPTIONS_PATH}" ]]; then
    echo ""
    return
  fi

  jq -c '{
    hikvision_1_enabled,
    hikvision_1_name,
    hikvision_1_host,
    hikvision_1_username,
    hikvision_1_password,
    hikvision_1_camera_number,
    hikvision_1_access_protocol,
    hikvision_1_rtsp_transport,
    hikvision_1_rtsp_main,
    hikvision_1_rtsp_sub,
    hikvision_1_onvif_url,
    hikvision_1_isapi_base_url,
    hikvision_1_record,
    hikvision_1_low_latency,
    hikvision_1_snapshot_stream,
    hikvision_1_live_stream,
    hikvision_1_record_stream,
    hikvision_2_enabled,
    hikvision_2_name,
    hikvision_2_host,
    hikvision_2_username,
    hikvision_2_password,
    hikvision_2_camera_number,
    hikvision_2_access_protocol,
    hikvision_2_rtsp_transport,
    hikvision_2_rtsp_main,
    hikvision_2_rtsp_sub,
    hikvision_2_onvif_url,
    hikvision_2_isapi_base_url,
    hikvision_2_record,
    hikvision_2_low_latency,
    hikvision_2_snapshot_stream,
    hikvision_2_live_stream,
    hikvision_2_record_stream
  }' "${OPTIONS_PATH}" 2>/dev/null | sha256sum | awk '{print $1}'
}

default_if_empty() {
  local value="$1"
  local fallback="$2"

  if [[ -n "${value}" && "${value}" != "null" ]]; then
    echo "${value}"
  else
    echo "${fallback}"
  fi
}

build_hikvision_rtsp() {
  local explicit="$1"
  local host="$2"
  local username="$3"
  local password="$4"
  local channel="$5"

  case "${channel}" in
    ''|*[!0-9]*) channel="102" ;;
  esac

  if [[ -n "${explicit}" && "${explicit}" != "null" ]]; then
    echo "${explicit}"
  elif [[ -n "${host}" && -n "${username}" && -n "${password}" ]]; then
    echo "rtsp://${username}:${password}@${host}:554/Streaming/Channels/${channel}"
  else
    echo ""
  fi
}

hikvision_channel_from_rtsp() {
  local value="$1"
  local fallback="$2"

  if [[ "${value}" =~ /Streaming/Channels/([0-9]+) ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo "${fallback}"
  fi
}

write_addon_options_config() {
  local output="$1"
  local camera1_name camera1_host camera1_username camera1_password
  local camera1_rtsp_main camera1_rtsp_sub camera1_onvif camera1_isapi
  local camera1_enabled camera1_record camera1_low_latency camera1_snapshot_stream camera1_live_stream camera1_record_stream
  local camera1_camera_number camera1_access_protocol camera1_rtsp_transport camera1_rtsp_main_channel camera1_rtsp_sub_channel
  local camera2_name camera2_host camera2_username camera2_password
  local camera2_rtsp_main camera2_rtsp_sub camera2_onvif camera2_isapi
  local camera2_enabled camera2_record camera2_low_latency camera2_snapshot_stream camera2_live_stream camera2_record_stream
  local camera2_camera_number camera2_access_protocol camera2_rtsp_transport camera2_rtsp_main_channel camera2_rtsp_sub_channel
  camera1_name="$(read_option 'hikvision_1_name' 'Hikvision 1')"
  camera1_host="$(read_option 'hikvision_1_host' '')"
  camera1_username="$(read_option 'hikvision_1_username' 'admin')"
  camera1_password="$(read_option 'hikvision_1_password' '')"
  camera1_camera_number="$(read_option 'hikvision_1_camera_number' '1')"
  case "${camera1_camera_number}" in ''|*[!0-9]*) camera1_camera_number="1" ;; esac
  camera1_access_protocol="$(read_option 'hikvision_1_access_protocol' 'rtsp')"
  camera1_rtsp_transport="$(read_option 'hikvision_1_rtsp_transport' 'tcp')"
  camera1_enabled="$(read_option 'hikvision_1_enabled' 'false')"
  camera1_record="$(read_option 'hikvision_1_record' 'true')"
  camera1_low_latency="$(read_option 'hikvision_1_low_latency' 'true')"
  camera1_snapshot_stream="$(read_option 'hikvision_1_snapshot_stream' 'sub')"
  camera1_live_stream="$(read_option 'hikvision_1_live_stream' 'sub')"
  camera1_record_stream="$(read_option 'hikvision_1_record_stream' 'main')"
  camera1_rtsp_main="$(build_hikvision_rtsp "$(read_option 'hikvision_1_rtsp_main' '')" "${camera1_host}" "${camera1_username}" "${camera1_password}" "${camera1_camera_number}01")"
  camera1_rtsp_sub="$(build_hikvision_rtsp "$(read_option 'hikvision_1_rtsp_sub' '')" "${camera1_host}" "${camera1_username}" "${camera1_password}" "${camera1_camera_number}02")"
  camera1_rtsp_main_channel="$(hikvision_channel_from_rtsp "${camera1_rtsp_main}" "${camera1_camera_number}01")"
  camera1_rtsp_sub_channel="$(hikvision_channel_from_rtsp "${camera1_rtsp_sub}" "${camera1_camera_number}02")"
  camera1_onvif="$(read_option 'hikvision_1_onvif_url' '')"
  camera1_isapi="$(read_option 'hikvision_1_isapi_base_url' '')"
  if [[ -n "${camera1_host}" ]]; then
    camera1_onvif="$(default_if_empty "${camera1_onvif}" "http://${camera1_host}:80/onvif/device_service")"
    camera1_isapi="$(default_if_empty "${camera1_isapi}" "http://${camera1_host}")"
  fi

  camera2_name="$(read_option 'hikvision_2_name' 'Hikvision 2')"
  camera2_host="$(read_option 'hikvision_2_host' '')"
  camera2_username="$(read_option 'hikvision_2_username' 'admin')"
  camera2_password="$(read_option 'hikvision_2_password' '')"
  camera2_camera_number="$(read_option 'hikvision_2_camera_number' '2')"
  case "${camera2_camera_number}" in ''|*[!0-9]*) camera2_camera_number="2" ;; esac
  camera2_access_protocol="$(read_option 'hikvision_2_access_protocol' 'rtsp')"
  camera2_rtsp_transport="$(read_option 'hikvision_2_rtsp_transport' 'tcp')"
  camera2_enabled="$(read_option 'hikvision_2_enabled' 'false')"
  camera2_record="$(read_option 'hikvision_2_record' 'true')"
  camera2_low_latency="$(read_option 'hikvision_2_low_latency' 'true')"
  camera2_snapshot_stream="$(read_option 'hikvision_2_snapshot_stream' 'sub')"
  camera2_live_stream="$(read_option 'hikvision_2_live_stream' 'sub')"
  camera2_record_stream="$(read_option 'hikvision_2_record_stream' 'main')"
  camera2_rtsp_main="$(build_hikvision_rtsp "$(read_option 'hikvision_2_rtsp_main' '')" "${camera2_host}" "${camera2_username}" "${camera2_password}" "${camera2_camera_number}01")"
  camera2_rtsp_sub="$(build_hikvision_rtsp "$(read_option 'hikvision_2_rtsp_sub' '')" "${camera2_host}" "${camera2_username}" "${camera2_password}" "${camera2_camera_number}02")"
  camera2_rtsp_main_channel="$(hikvision_channel_from_rtsp "${camera2_rtsp_main}" "${camera2_camera_number}01")"
  camera2_rtsp_sub_channel="$(hikvision_channel_from_rtsp "${camera2_rtsp_sub}" "${camera2_camera_number}02")"
  camera2_onvif="$(read_option 'hikvision_2_onvif_url' '')"
  camera2_isapi="$(read_option 'hikvision_2_isapi_base_url' '')"
  if [[ -n "${camera2_host}" ]]; then
    camera2_onvif="$(default_if_empty "${camera2_onvif}" "http://${camera2_host}:80/onvif/device_service")"
    camera2_isapi="$(default_if_empty "${camera2_isapi}" "http://${camera2_host}")"
  fi

  jq -n \
    --arg listen "0.0.0.0:${API_PORT}" \
    --arg recordings_dir "${RECORDINGS_DIR}" \
    --arg database_path "${DATABASE_PATH}" \
    --arg retention_days "${RETENTION_DAYS}" \
    --arg camera1_name "${camera1_name}" \
    --arg camera1_host "${camera1_host}" \
    --arg camera1_username "${camera1_username}" \
    --arg camera1_password "${camera1_password}" \
    --arg camera1_camera_number "${camera1_camera_number}" \
    --arg camera1_access_protocol "${camera1_access_protocol}" \
    --arg camera1_rtsp_transport "${camera1_rtsp_transport}" \
    --arg camera1_rtsp_main "${camera1_rtsp_main}" \
    --arg camera1_rtsp_sub "${camera1_rtsp_sub}" \
    --arg camera1_onvif "${camera1_onvif}" \
    --arg camera1_isapi "${camera1_isapi}" \
    --arg camera1_enabled "${camera1_enabled}" \
    --arg camera1_record "${camera1_record}" \
    --arg camera1_low_latency "${camera1_low_latency}" \
    --arg camera1_snapshot_stream "${camera1_snapshot_stream}" \
    --arg camera1_live_stream "${camera1_live_stream}" \
    --arg camera1_record_stream "${camera1_record_stream}" \
    --arg camera1_rtsp_main_channel "${camera1_rtsp_main_channel}" \
    --arg camera1_rtsp_sub_channel "${camera1_rtsp_sub_channel}" \
    --arg camera2_name "${camera2_name}" \
    --arg camera2_host "${camera2_host}" \
    --arg camera2_username "${camera2_username}" \
    --arg camera2_password "${camera2_password}" \
    --arg camera2_camera_number "${camera2_camera_number}" \
    --arg camera2_access_protocol "${camera2_access_protocol}" \
    --arg camera2_rtsp_transport "${camera2_rtsp_transport}" \
    --arg camera2_rtsp_main "${camera2_rtsp_main}" \
    --arg camera2_rtsp_sub "${camera2_rtsp_sub}" \
    --arg camera2_onvif "${camera2_onvif}" \
    --arg camera2_isapi "${camera2_isapi}" \
    --arg camera2_enabled "${camera2_enabled}" \
    --arg camera2_record "${camera2_record}" \
    --arg camera2_low_latency "${camera2_low_latency}" \
    --arg camera2_snapshot_stream "${camera2_snapshot_stream}" \
    --arg camera2_live_stream "${camera2_live_stream}" \
    --arg camera2_record_stream "${camera2_record_stream}" \
    --arg camera2_rtsp_main_channel "${camera2_rtsp_main_channel}" \
    --arg camera2_rtsp_sub_channel "${camera2_rtsp_sub_channel}" \
    '{
      server: {
        listen: $listen,
        public_url: ""
      },
      storage: {
        recordings_dir: $recordings_dir,
        database_path: $database_path,
        retention_days: ($retention_days | tonumber)
      },
      live: {engine: "edge_rtc"},
      cameras: [
        {
          id: "hikvision_1",
          name: $camera1_name,
          vendor: "hikvision",
          host: $camera1_host,
          username: $camera1_username,
          password: $camera1_password,
          camera_number: $camera1_camera_number,
          access_protocol: (if ($camera1_access_protocol == "isapi" or $camera1_access_protocol == "onvif" or $camera1_access_protocol == "unicast" or $camera1_access_protocol == "multicast") then $camera1_access_protocol else "rtsp" end),
          rtsp_transport: (if ($camera1_rtsp_transport == "udp" or $camera1_rtsp_transport == "auto") then $camera1_rtsp_transport else "tcp" end),
          rtsp_main: $camera1_rtsp_main,
          rtsp_sub: $camera1_rtsp_sub,
          rtsp_main_channel: $camera1_rtsp_main_channel,
          rtsp_sub_channel: $camera1_rtsp_sub_channel,
          onvif_url: $camera1_onvif,
          isapi_base_url: $camera1_isapi,
          enabled: ($camera1_enabled == "true"),
          record: ($camera1_record == "true"),
          low_latency: ($camera1_low_latency == "true"),
          snapshot_stream: (if $camera1_snapshot_stream == "main" then "main" else "sub" end),
          live_stream: (if $camera1_live_stream == "main" then "main" else "sub" end),
          record_stream: (if $camera1_record_stream == "sub" then "sub" else "main" end)
        },
        {
          id: "hikvision_2",
          name: $camera2_name,
          vendor: "hikvision",
          host: $camera2_host,
          username: $camera2_username,
          password: $camera2_password,
          camera_number: $camera2_camera_number,
          access_protocol: (if ($camera2_access_protocol == "isapi" or $camera2_access_protocol == "onvif" or $camera2_access_protocol == "unicast" or $camera2_access_protocol == "multicast") then $camera2_access_protocol else "rtsp" end),
          rtsp_transport: (if ($camera2_rtsp_transport == "udp" or $camera2_rtsp_transport == "auto") then $camera2_rtsp_transport else "tcp" end),
          rtsp_main: $camera2_rtsp_main,
          rtsp_sub: $camera2_rtsp_sub,
          rtsp_main_channel: $camera2_rtsp_main_channel,
          rtsp_sub_channel: $camera2_rtsp_sub_channel,
          onvif_url: $camera2_onvif,
          isapi_base_url: $camera2_isapi,
          enabled: ($camera2_enabled == "true"),
          record: ($camera2_record == "true"),
          low_latency: ($camera2_low_latency == "true"),
          snapshot_stream: (if $camera2_snapshot_stream == "main" then "main" else "sub" end),
          live_stream: (if $camera2_live_stream == "main" then "main" else "sub" end),
          record_stream: (if $camera2_record_stream == "sub" then "sub" else "main" end)
        }
      ],
      future_vendors: [
        "dahua",
        "onvif",
        "rtsp"
      ]
    }' > "${output}"
  if jq -e '.cameras | type == "array" and length > 0' "${OPTIONS_PATH}" >/dev/null 2>&1; then
    jq --slurpfile options "${OPTIONS_PATH}" '.cameras = $options[0].cameras' "${output}" > "${output}.cameras.tmp"
    mv "${output}.cameras.tmp" "${output}"
  fi
  jq --slurpfile options "${OPTIONS_PATH}" 'def opt($key;$default): if $options[0]|has($key) then $options[0][$key] else $default end; .detection = {camera_events_enabled: opt("camera_events_enabled";false), local_enabled: opt("local_detection_enabled";false), max_fps: opt("detection_fps";1), decoder: opt("detection_decoder";"auto"), confidence: opt("detection_confidence";0.45), animal_confidence: opt("detection_animal_confidence";0.35), hold_seconds: opt("detection_hold_seconds";10), person_enabled: opt("detection_person_enabled";true), animal_enabled: opt("detection_animal_enabled";true), vehicle_enabled: opt("detection_vehicle_enabled";true), alert_media_mb: opt("detection_alert_media_mb";256), pre_seconds: opt("detection_pre_seconds";5), post_seconds: opt("detection_post_seconds";15), notifications_enabled: opt("detection_notifications_enabled";false), notify_service: opt("detection_notify_service";""), notify_cooldown: opt("detection_notify_cooldown";30), notify_path: opt("detection_notify_path";"")}' "${output}" > "${output}.detection.tmp"
  mv "${output}.detection.tmp" "${output}"
}

bashio::log.info "Starting Edge of Infinity"
bashio::log.info "Log level: ${LOG_LEVEL}"
bashio::log.info "API port: ${API_PORT}"
bashio::log.info "Recordings: ${RECORDINGS_DIR}"
bashio::log.info "Database: ${DATABASE_PATH}"
bashio::log.info "Retention days: ${RETENTION_DAYS}"
bashio::log.info "Install custom component: ${INSTALL_CUSTOM_COMPONENT}"

install_custom_component

EDGE_HOME_CONFIG=/homeassistant/edge/edge.json
EDGE_PANEL_CONFIG=/homeassistant/edge/panel-config.json
EDGE_HOME_EXAMPLE_CONFIG=/homeassistant/edge/edge.example.json
EDGE_ADDON_CONFIG=/config/edge.json
EDGE_ADDON_EXAMPLE_CONFIG=/config/edge.example.json
EDGE_OPTIONS_CONFIG=/tmp/edge-runtime/edge.options.json

cat > "${EDGE_HOME_EXAMPLE_CONFIG}" <<'EOF'
{
  "server": {
    "listen": "0.0.0.0:8088",
    "public_url": ""
  },
  "storage": {
    "recordings_dir": "/media/edge-of-infinity/recordings",
    "database_path": "/homeassistant/edge/edge.db",
    "retention_days": 14
  },
  "live": {
    "engine": "edge_rtc"
  },
  "cameras": [
    {
      "id": "hikvision_1",
      "name": "Hikvision 1",
      "vendor": "hikvision",
      "host": "192.168.1.64",
      "username": "admin",
      "password": "change-me",
      "camera_number": "1",
      "access_protocol": "rtsp",
      "rtsp_transport": "tcp",
      "rtsp_main": "rtsp://admin:change-me@192.168.1.64:554/Streaming/Channels/101",
      "rtsp_sub": "rtsp://admin:change-me@192.168.1.64:554/Streaming/Channels/102",
      "rtsp_main_channel": "101",
      "rtsp_sub_channel": "102",
      "onvif_url": "http://192.168.1.64:80/onvif/device_service",
      "isapi_base_url": "http://192.168.1.64",
      "enabled": false,
      "record": true,
      "low_latency": true,
      "snapshot_stream": "sub",
      "live_stream": "sub",
      "record_stream": "main"
    },
    {
      "id": "hikvision_2",
      "name": "Hikvision 2",
      "vendor": "hikvision",
      "host": "192.168.1.65",
      "username": "admin",
      "password": "change-me",
      "camera_number": "2",
      "access_protocol": "rtsp",
      "rtsp_transport": "tcp",
      "rtsp_main": "rtsp://admin:change-me@192.168.1.65:554/Streaming/Channels/201",
      "rtsp_sub": "rtsp://admin:change-me@192.168.1.65:554/Streaming/Channels/202",
      "rtsp_main_channel": "201",
      "rtsp_sub_channel": "202",
      "onvif_url": "http://192.168.1.65:80/onvif/device_service",
      "isapi_base_url": "http://192.168.1.65",
      "enabled": false,
      "record": true,
      "low_latency": true,
      "snapshot_stream": "sub",
      "live_stream": "sub",
      "record_stream": "main"
    }
  ],
  "future_vendors": [
    "dahua",
    "onvif",
    "rtsp"
  ]
}
EOF
cp "${EDGE_HOME_EXAMPLE_CONFIG}" "${EDGE_ADDON_EXAMPLE_CONFIG}"

ADDON_OPTIONS_HASH_PATH=/homeassistant/edge/addon-options.hash
ADDON_OPTIONS_HASH="$(addon_camera_options_hash)"
PREVIOUS_ADDON_OPTIONS_HASH=""
if [[ -f "${ADDON_OPTIONS_HASH_PATH}" ]]; then
  PREVIOUS_ADDON_OPTIONS_HASH="$(cat "${ADDON_OPTIONS_HASH_PATH}")"
fi

if [[ -f "${EDGE_HOME_CONFIG}" ]] && ! jq -e 'type == "object" and (.cameras | type == "array")' "${EDGE_HOME_CONFIG}" >/dev/null 2>&1; then
  bashio::log.error "Invalid authoritative config ${EDGE_HOME_CONFIG}. Refusing to restore stale settings from mirrors; repair the JSON file."
  exit 1
fi

if [[ -f "${EDGE_HOME_CONFIG}" ]] && jq -e '.cameras | type == "array"' "${EDGE_HOME_CONFIG}" >/dev/null 2>&1; then
  EDGE_CONFIG="${EDGE_HOME_CONFIG}"
  cp "${EDGE_HOME_CONFIG}" "${EDGE_PANEL_CONFIG}"
  bashio::log.info "Using ${EDGE_HOME_CONFIG} as the authoritative camera config. Mirroring it to ${EDGE_PANEL_CONFIG} for diagnostics."
elif [[ -f "${EDGE_PANEL_CONFIG}" ]] && jq -e '.cameras | type == "array" and length > 0' "${EDGE_PANEL_CONFIG}" >/dev/null 2>&1; then
  EDGE_CONFIG="${EDGE_HOME_CONFIG}"
  cp "${EDGE_PANEL_CONFIG}" "${EDGE_HOME_CONFIG}"
  bashio::log.warning "Migrated legacy panel config ${EDGE_PANEL_CONFIG} to authoritative ${EDGE_HOME_CONFIG}."
elif has_addon_camera_options && [[ ! -f "${EDGE_HOME_CONFIG}" ]]; then
  EDGE_CONFIG="${EDGE_HOME_CONFIG}"
  write_addon_options_config "${EDGE_CONFIG}"
  echo "${ADDON_OPTIONS_HASH}" > "${ADDON_OPTIONS_HASH_PATH}"
  bashio::log.info "Created camera config from Home Assistant add-on options at ${EDGE_CONFIG}."
elif has_addon_camera_options && [[ -f "${EDGE_HOME_CONFIG}" ]]; then
  EDGE_CONFIG="${EDGE_HOME_CONFIG}"
  write_addon_options_config "${EDGE_OPTIONS_CONFIG}"
  echo "${ADDON_OPTIONS_HASH}" > "${ADDON_OPTIONS_HASH_PATH}"
  if [[ "${SYNC_ADDON_OPTIONS}" == "true" ]]; then
    bashio::log.warning "sync_addon_options is enabled, but panel config already exists. Keeping ${EDGE_CONFIG} as source of truth and writing add-on options only to ${EDGE_OPTIONS_CONFIG}."
  else
    bashio::log.info "Panel camera config already exists. Keeping ${EDGE_CONFIG} as source of truth."
  fi
elif [[ -f "${EDGE_HOME_CONFIG}" ]]; then
  EDGE_CONFIG="${EDGE_HOME_CONFIG}"
  bashio::log.info "Using Home Assistant camera config at ${EDGE_CONFIG}"
elif [[ -f "${EDGE_ADDON_CONFIG}" ]]; then
  EDGE_CONFIG="${EDGE_ADDON_CONFIG}"
  bashio::log.info "Using add-on camera config at ${EDGE_CONFIG}"
else
  EDGE_CONFIG="${EDGE_HOME_CONFIG}"
  bashio::log.info "Creating first-run camera config at ${EDGE_CONFIG}"
  cp "${EDGE_HOME_EXAMPLE_CONFIG}" "${EDGE_CONFIG}"
fi

if [[ -f "${EDGE_CONFIG}" && "${EDGE_CONFIG}" != "${EDGE_ADDON_CONFIG}" ]]; then
  if cp "${EDGE_CONFIG}" "${EDGE_ADDON_CONFIG}"; then
    bashio::log.info "Mirrored active camera config to ${EDGE_ADDON_CONFIG} for app configuration visibility."
  else
    bashio::log.warning "Could not mirror active camera config to ${EDGE_ADDON_CONFIG}."
  fi
fi

EDGE_RTC_CONFIG=/tmp/edge-runtime/edge-rtc.json
EDGE_RTC_PID=""
cleanup_children() {
  if [[ -n "${EDGE_RTC_PID}" ]] && kill -0 "${EDGE_RTC_PID}" >/dev/null 2>&1; then
    kill "${EDGE_RTC_PID}" >/dev/null 2>&1 || true
  fi
}
trap cleanup_children EXIT TERM INT

python3 /usr/share/edge-of-infinity/edge_rtc_config.py "${EDGE_CONFIG}" /homeassistant/edge "${EDGE_RTC_CONFIG}" "${EDGE_RTC_RTSP_PORT}" "${EDGE_RTC_API_PORT}"
bashio::log.info "Starting EdgeRTC: one shared camera source for Live, recording and analysis; indexed DVR for archives."
if ! command -v edge-rtc >/dev/null 2>&1; then
  bashio::log.error "EdgeRTC binary is missing."
  exit 1
fi
edge-rtc --config "${EDGE_RTC_CONFIG}" &
EDGE_RTC_PID="$!"
for _edge_wait in $(seq 1 10); do
  if ! kill -0 "${EDGE_RTC_PID}" >/dev/null 2>&1; then
    bashio::log.error "EdgeRTC stopped before its listener became ready."
    exit 1
  fi
  if nc -z 127.0.0.1 "${EDGE_RTC_RTSP_PORT}" 2>/dev/null; then
    break
  fi
  sleep 1
done
if ! nc -z 127.0.0.1 "${EDGE_RTC_RTSP_PORT}" 2>/dev/null; then
  bashio::log.error "EdgeRTC RTSP listener did not start."
  exit 1
fi

export EDGE_RTC_CONFIG EDGE_RTC_RTSP_PORT EDGE_RTC_API_PORT
export EDGE_CONFIG EDGE_HOME_CONFIG EDGE_ADDON_CONFIG
export EDGE_HOME_DIR=/homeassistant/edge
export EDGE_DATA_DIR=/tmp/edge-placeholder
export API_PORT
exec python3 /usr/share/edge-of-infinity/edge-panel.py
